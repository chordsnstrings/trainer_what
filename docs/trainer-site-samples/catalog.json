{
  "version": 1,
  "status": "visual-benchmarks-not-production-integration",
  "contract": {
    "selection": "Choose one coherent art direction from public brief, audience, tone and approved media. Select compatible module variants within it; do not randomly combine all ten styles.",
    "content": "Ground public copy, programme terms and prices in confirmed trainer facts. Demo content is fictional. Never invent credentials, reviews or outcomes.",
    "media": "Use tenant-owned rights-approved media. Stock photographs in these samples establish composition only. Motion and 3D do not require private coaching data.",
    "editing": "Keep module IDs stable; content, imagery, tokens, order and permitted scene parameters are separate. Preserve trainer locks and existing revision/history checks during future integration.",
    "safety": "No model-authored executable JavaScript, HTML, shaders or external URLs. Choose from registered scene and module IDs with validated parameters.",
    "motion": "Native scrolling; no wheel hijacking. Reduced motion presents static compositions. One WebGL canvas per sample, lazy-loaded and rendered on demand."
  },
