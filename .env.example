NODE_ENV=development
PUBLIC_APP_URL=http://localhost:3000
API_PORT=4000
API_HOST=127.0.0.1
API_INTERNAL_URL=http://127.0.0.1:4000
# Raw random string of at least 32 UTF-8 bytes. The API and web server must use
# the SAME value and PUBLIC_APP_URL. Keep separate from the encryption key.
# Generate in your secret manager; do not put this value in NEXT_PUBLIC_*.
INTERNAL_PROXY_SECRET=
# Leave DATABASE_URL empty for embedded PostgreSQL in local development.
# Production requires a non-superuser PostgreSQL runtime connection.
DATABASE_URL=
MIGRATION_DATABASE_URL=
PGLITE_DATA_DIR=.data/postgres
COMMERCE_APPROVED=false
PAYOUTS_APPROVED=false
LEAN_CONTRACT_VERIFIED=false
# Generate a base64-encoded 32-byte key in your secret manager. Never commit it.
# Also encrypts Superadmin provider credentials. Back it up separately from the database.
SECURITY_ENCRYPTION_KEY=
LEGAL_APPROVED=false
FILE_IMPORTS_APPROVED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LEAN_BASE_URL=
LEAN_ACCESS_TOKEN=
LEAN_SOURCE_ACCOUNT_ID=
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_INPUT_USD_PER_MILLION=
MODEL_OUTPUT_USD_PER_MILLION=
# Use a reviewed provider price version. Missing usage/prices are unknown, never free.
MODEL_PRICE_VERSION=
MODEL_MAX_DAILY_CALLS=100
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=

# Container database initialization only; never share this with API/web/worker.
POSTGRES_PASSWORD=

# Nutrition: prepare and evaluate coach knowledge before production activation.
NUTRITION_ENABLED=false
NUTRITION_SCOPE_APPROVED=false
# Reviewed billing portal policy: invoice prorated upgrades; schedule price decreases.
BUNDLE_CHANGES_APPROVED=false

# Optional initial defaults; saved Superadmin settings override these values.
APP_NAME=Trainer Brain
SUPPORT_EMAIL=
STRIPE_PUBLISHABLE_KEY=
APPLE_IMPORTS_ENABLED=true
MEAL_PHOTOS_ENABLED=false
FOOD_LOOKUP_ENABLED=false
MODEL_VISION_ENABLED=false
